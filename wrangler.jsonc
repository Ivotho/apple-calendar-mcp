{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apple-calendar-mcp",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "CALENDAR_TIME_ZONE": "Europe/Berlin"
  },
  "secrets": {
    "required": ["ICLOUD_USERNAME", "ICLOUD_APP_PASSWORD", "APPROVAL_PASSWORD"]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV","id": "b7bbf0588f784230b4d3d7f66ebc1c1d" }]
}
